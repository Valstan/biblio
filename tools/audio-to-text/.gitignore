# Тяжёлое и рантайм-артефакты — НЕ в git (репо держим лёгким).
# Штатно модели качаются в ~/.cache (gigaam/torch/huggingface), не сюда —
# но этот список ловит всё, что вдруг окажется в папке инструмента.

# venv с torch и пр. зависимостями
.venv/
__pycache__/
*.pyc

# логи установки/запуска (install.ps1, эксперименты)
*.log

# модели и веса (подстраховка — штатно они в ~/.cache)
models/
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.model

# временные выгрузки текста (сохранённые распознавания)
*.txt
!requirements.txt
